  "note": "Levels where big players act. Four families: where they showed their hand (intervention, options, positioning, flow, floors); their cost basis (anchored VWAP, volume profile); the reference points they hedge and report against (year / quarter opens, prior-quarter range); and macro forced-hand levels (rate-spread fair value, exporter pain, bond yield caps, fixing bands and pegs).",
  "types": {
    "intervention": {
      "family": "hand",
      "desc": "Central bank / finance ministry stepped in or warned here"
    },
    "options": {
      "family": "hand",
      "desc": "Large option strike or barrier being defended"
    },
    "positioning": {
      "family": "hand",
      "desc": "COT / flow extreme marked here"
    },
    "flow": {
      "family": "hand",
      "desc": "Heavy institutional buying or selling reaction"
    },
    "cb-floor": {
      "family": "hand",
      "desc": "Stated or implied central-bank floor or cap"
    },
    "avwap": {
      "family": "cost",
      "desc": "Anchored VWAP from a key day (central-bank decision, intervention, big data surprise). Price above = institutions positioned since then are in profit; below = under water."
    },
    "volume-profile": {
      "family": "cost",
      "desc": "High-volume node, point of control or value-area edge: where the big business got done. Acceptance or rejection there matters."
    },
    "period-open": {
      "family": "reference",
      "desc": "Year or quarter open, prior-quarter high or low. Funds and banks hedge and report against these."
    },
    "rate-spread": {
      "family": "macro",
      "desc": "Fair value implied by the 2Y yield gap. Price stretched far from it = price and rates disagree (the pricing gap)."
    },
    "exporter-pain": {
      "family": "macro",
      "desc": "Exchange rate companies say they can live with (e.g. Tankan large manufacturers' assumed USD/JPY). Beyond it, pressure builds on the central bank."
    },
    "yield-cap": {
      "family": "macro",
      "desc": "Bond yield where a central bank has stepped in before or caps it (BoJ 10Y cap under YCC, BoE gilt buying 2022)."
    },
    "fixing-peg": {
      "family": "macro",
      "desc": "Official fix, band or peg (PBoC daily CNY fix and its ±2% band, SNB EUR/CHF 1.20 floor 2011-2015)."
    }
  },
