node_modules/
*.log

# .claude/agents is a Windows directory symlink into the Omni AI system folder.
# Committing it would store a dead absolute path that breaks on Linux CI.
.claude/agents

# Local secrets — connectors read API keys from the environment, never from files.
.env
.env.*

# Linked into the central Omni AI system - not part of this repo
.claude/agents
.claude/skills
.opencode/agent
.opencode/skills

# Workbook backups — local safety copies, only taken before big system changes
backups/

# Ebooks and course PDFs — copyrighted, kept local only (repo is public)
library/
*.pdf

# Local run of scripts/desk-live.mjs (CI publishes the real one to the desk-live branch)
dashboard/desk/data/live.json

# Podcast and video transcripts dropped for the idea-researcher agent. Publishers' material, local only.
inbox/
