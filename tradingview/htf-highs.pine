//@version=6
// HTF Highs — marks yearly / 6-month / 3-month / monthly / weekly / daily highs as liquidity levels.
// Which levels show depends on the chart timeframe, so a 4-chart layout stays clean:
//   daily & weekly charts  -> yearly + 3-month (defaults)
//   intraday charts        -> 6-month + monthly + weekly + previous day (defaults)
// Every level can be switched on or off per chart type in the inputs.
// Lines start where the current period began and end a few bars right of price, label on the end.
indicator("HTF Highs", overlay = true, max_lines_count = 20, max_labels_count = 20)

usePrev = input.string("Previous period", "Level", options = ["Previous period", "Current period"],
     tooltip = "Previous period = last completed year / 6M / 3M / month / week / day (PDH, PWH...). Current period = running high of the period still open.") == "Previous period"
col     = input.color(#b8860b, "Colour")
extBars = input.int(8, "Extend right (bars)", minval = 1)

G_HTF = "Show on daily & weekly charts"
hY  = input.bool(true,  "Yearly",       group = G_HTF)
h6  = input.bool(false, "6-month",      group = G_HTF)
h3  = input.bool(true,  "3-month",      group = G_HTF)
hM  = input.bool(false, "Monthly",      group = G_HTF)
hW  = input.bool(false, "Weekly",       group = G_HTF)
hD  = input.bool(false, "Day",          group = G_HTF)

G_LTF = "Show on intraday charts"
lY  = input.bool(false, "Yearly",       group = G_LTF)
l6  = input.bool(true,  "6-month",      group = G_LTF)
l3  = input.bool(false, "3-month",      group = G_LTF)
lM  = input.bool(true,  "Monthly",      group = G_LTF)
lW  = input.bool(true,  "Weekly",       group = G_LTF)
lD  = input.bool(true,  "Day",          group = G_LTF)

isHTF = timeframe.in_seconds() >= 86400

// [level, start time of the current period] for one higher timeframe.
// lookahead_on + [1] = last completed period, never repaints. Without [1] = running high (only read on the last bar).
level(tf) =>
    [hPrev, hCur, t0] = request.security(syminfo.tickerid, tf, [high[1], high, time], lookahead = barmerge.lookahead_on)
    [usePrev ? hPrev : hCur, t0]

[yv, yt] = level("12M")
[sv, st] = level("6M")
[qv, qt] = level("3M")
[mv, mt] = level("M")
[wv, wt] = level("W")
[dv, dt] = level("D")

// Collect enabled levels; levels at the same price share one line and one label ("PYH / P3MH").
add(array<float> prices, array<string> texts, array<int> starts, array<int> widths, bool show, string tf, float v, int t0, string name, int w) =>
    if show and not na(v) and timeframe.in_seconds(tf) >= timeframe.in_seconds()
        i = prices.indexof(v)
        if i >= 0
            texts.set(i, texts.get(i) + " / " + name)
            starts.set(i, math.min(starts.get(i), t0))
            widths.set(i, math.max(widths.get(i), w))
        else
            prices.push(v)
            texts.push(name)
            starts.push(t0)
            widths.push(w)

var line[]  lines  = array.new<line>()
var label[] labels = array.new<label>()

if barstate.islast
    for l in lines
        l.delete()
    for lb in labels
        lb.delete()
    lines.clear()
    labels.clear()

    p = usePrev ? "P" : ""
    prices = array.new<float>()
    texts  = array.new<string>()
    starts = array.new<int>()
    widths = array.new<int>()

    add(prices, texts, starts, widths, isHTF ? hY : lY, "12M", yv, yt, p + "YH",  3)
    add(prices, texts, starts, widths, isHTF ? h6 : l6, "6M",  sv, st, p + "6MH", 2)
    add(prices, texts, starts, widths, isHTF ? h3 : l3, "3M",  qv, qt, p + "3MH", 2)
    add(prices, texts, starts, widths, isHTF ? hM : lM, "M",   mv, mt, p + "MH",  2)
    add(prices, texts, starts, widths, isHTF ? hW : lW, "W",   wv, wt, p + "WH",  1)
    add(prices, texts, starts, widths, isHTF ? hD : lD, "D",   dv, dt, p + "DH",  1)

    x2 = time + extBars * timeframe.in_seconds() * 1000
    for [i, v] in prices
        lines.push(line.new(starts.get(i), v, x2, v, xloc.bar_time, color = col, width = widths.get(i)))
        labels.push(label.new(x2, v, texts.get(i), xloc.bar_time, style = label.style_label_left,
             color = color(na), textcolor = col, size = size.small))
