//@version=6
// HTF Highs — yearly / 6-month / 3-month / monthly / weekly / daily highs as liquidity levels.
// Which levels show depends on the chart timeframe, so a 4-chart layout stays clean:
//   daily & weekly charts  -> yearly + 3-month (defaults)
//   intraday charts        -> 6-month + monthly + weekly + previous day (defaults)
// Clean style: thin line from the wick that made the high to the right edge of the chart, one colour per level,
// a short tag above the line end (Y, 6M, 3M, M, W, D). Hover a tag for the exact level.
indicator("HTF Highs", overlay = true, max_lines_count = 20, max_labels_count = 20, max_bars_back = 5000)

usePrev = input.string("Previous period", "Level", options = ["Previous period", "Current period"],
     tooltip = "Previous period = last completed year / 6M / 3M / month / week / day. Current period = running high of the period still open.") == "Previous period"

G = "Show on: daily & weekly charts | intraday charts | colour"
hY = input.bool(true,  "Yearly",  inline = "y", group = G)
lY = input.bool(false, "",        inline = "y", group = G)
cY = input.color(#2962ff, "",     inline = "y", group = G)
h6 = input.bool(false, "6-month", inline = "6", group = G)
l6 = input.bool(true,  "",        inline = "6", group = G)
c6 = input.color(#4caf50, "",     inline = "6", group = G)
h3 = input.bool(true,  "3-month", inline = "3", group = G)
l3 = input.bool(false, "",        inline = "3", group = G)
c3 = input.color(#9c27b0, "",     inline = "3", group = G)
hM = input.bool(false, "Monthly", inline = "m", group = G)
lM = input.bool(true,  "",        inline = "m", group = G)
cM = input.color(#f23645, "",     inline = "m", group = G)
hW = input.bool(false, "Weekly",  inline = "w", group = G)
lW = input.bool(true,  "",        inline = "w", group = G)
cW = input.color(#ff9800, "",     inline = "w", group = G)
hD = input.bool(false, "Day",     inline = "d", group = G)
lD = input.bool(true,  "",        inline = "d", group = G)
cD = input.color(#787b86, "",     inline = "d", group = G)

isHTF = timeframe.in_seconds() >= 86400

// [level, start time of the current period] for one higher timeframe.
// lookahead_on + [1] = last completed period, never repaints. Without [1] = running high (only read on the last bar).
level(tf) =>
    [hPrev, hCur, t0] = request.security(syminfo.tickerid, tf, [high[1], high, time], lookahead = barmerge.lookahead_on)
    [usePrev ? hPrev : hCur, t0]

[yv, yt] = level("12M")
[sv, st] = level("6M")
[qv, qt] = level("3M")
[mv, mt] = level("M")
[wv, wt] = level("W")
[dv, dt] = level("D")

// Time of the most recent loaded bar whose high is the level; falls back to the period start if it is older than the chart's history.
wickTime(float v, int fallback) =>
    int t = fallback
    int n = math.min(bar_index, 4999)
    for i = 0 to n
        if math.abs(high[i] - v) <= syminfo.mintick / 2
            t := time[i]
            break
    t

// Collect enabled levels; levels at the same price share one line and one tag ("3M / Y"), coloured by the longer period.
add(array<float> prices, array<string> texts, array<int> starts, array<color> cols, bool show, string tf, float v, int t0, string name, color c) =>
    if show and not na(v) and timeframe.in_seconds(tf) >= timeframe.in_seconds()
        i = prices.indexof(v)
        if i >= 0
            texts.set(i, texts.get(i) + " / " + name)
        else
            prices.push(v)
            texts.push(name)
            starts.push(wickTime(v, t0))
            cols.push(c)

var line[]  lines  = array.new<line>()
var label[] labels = array.new<label>()

if barstate.islast
    for l in lines
        l.delete()
    for lb in labels
        lb.delete()
    lines.clear()
    labels.clear()

    prices = array.new<float>()
    texts  = array.new<string>()
    starts = array.new<int>()
    cols   = array.new<color>()

    // longest period first, so a merged tag keeps the longer period's colour
    add(prices, texts, starts, cols, isHTF ? hY : lY, "12M", yv, yt, "Y",  cY)
    add(prices, texts, starts, cols, isHTF ? h6 : l6, "6M",  sv, st, "6M", c6)
    add(prices, texts, starts, cols, isHTF ? h3 : l3, "3M",  qv, qt, "3M", c3)
    add(prices, texts, starts, cols, isHTF ? hM : lM, "M",   mv, mt, "M",  cM)
    add(prices, texts, starts, cols, isHTF ? hW : lW, "W",   wv, wt, "W",  cW)
    add(prices, texts, starts, cols, isHTF ? hD : lD, "D",   dv, dt, "D",  cD)

    xEnd = chart.right_visible_bar_time
    word = usePrev ? "previous" : "current"
    for [i, v] in prices
        c = cols.get(i)
        lines.push(line.new(starts.get(i), v, xEnd, v, xloc.bar_time, extend.none, c, line.style_solid, 1))
        labels.push(label.new(xEnd, v, texts.get(i), xloc.bar_time, style = label.style_label_lower_right,
             color = color(na), textcolor = c, size = size.small,
             tooltip = texts.get(i) + " high (" + word + " period): " + str.tostring(v, format.mintick)))
